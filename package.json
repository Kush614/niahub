{
  "name": "niahub",
  "version": "0.1.0",
  "private": true,
  "description": "The Nia Index Marketplace. One line, perfect context for any MCP-compatible agent.",
  "workspaces": [
    "apps/web",
    "apps/mcp",
    "apps/aside-extension"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "mcp:build": "npm run build --workspace apps/mcp",
    "bootstrap": "tsx scripts/bootstrap-pack.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "seed": "tsx scripts/db-migrate.ts --seed"
  },
  "devDependencies": {
    "convex": "^1.38.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
