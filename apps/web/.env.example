# NiaHub environment — copy to .env.local

# --- Nia (Nozomio) ---
# Get a key by signing up: https://docs.trynia.ai/api-reference (auth tag).
# Header sent on every request: Authorization: Bearer $NIA_API_KEY
NIA_API_KEY=
NIA_API_BASE=https://apigcp.trynia.ai/v2
# Nia's MCP server is local-install (`npx nia-wizard@latest`) — NiaHub is the
# hosted MCP gateway, so this URL is only here for completeness.
NIA_MCP_BASE=https://apigcp.trynia.ai/v2/mcp

# --- InsForge ---
# Sign up via `npx @insforge/cli` (POST https://api.insforge.dev/agents/v1/signup).
# - INSFORGE_PROJECT_URL + ANON_KEY drive the @insforge/sdk client (auth).
# - SERVICE_KEY is the admin accessApiKey — server-only, never NEXT_PUBLIC_*.
# - DATABASE_URL is the raw Postgres URL InsForge gives you for migrations.
INSFORGE_PROJECT_URL=https://your-app.insforge.app
INSFORGE_ANON_KEY=
INSFORGE_SERVICE_KEY=
DATABASE_URL=postgres://niahub:niahub@localhost:5432/niahub

# --- Tensorlake ---
# Get a key from the Tensorlake dashboard. The `tensorlake` SDK reads
# TENSORLAKE_API_KEY from process.env automatically.
TENSORLAKE_API_KEY=
TENSORLAKE_PROJECT=niahub-indexer

# --- Convex ---
# Run `npx convex dev` once at the repo root to create the deployment and
# generate convex/_generated/. NEXT_PUBLIC_CONVEX_URL is what `convex dev`
# writes to .env.local; copy it here.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# --- Codex (sponsor) ---
CODEX_API_KEY=
CODEX_MODEL=gpt-codex-1

# --- Devin ---
DEVIN_API_KEY=

# --- Hyperspell ---
# Bearer token from app.hyperspell.com (the npm SDK is deprecated, we hit
# https://api.hyperspell.com/* directly).
HYPERSPELL_API_KEY=

# --- Aside ---
ASIDE_PUBLIC_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NIAHUB_GATEWAY_SIGNING_SECRET=dev-secret-change-me
